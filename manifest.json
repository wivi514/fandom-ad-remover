{
  "manifest_version": 3,
  "name": "Fandom Ad Remover",
  "version": "1.0.0",
  "description": "Collapses leftover ad containers (fandom-ad and friends) so blocked ads don't leave empty white boxes behind.",
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["src/rules.js", "src/content.js"]
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Fandom Ad Remover",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
